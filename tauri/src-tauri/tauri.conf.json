{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../dist",
    "distDir": "../dist"
  },
  "package": {
    "productName": "HashChat",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "HashChat (Tauri Phase3 High: strict FFI-only, TUI ultra-secure default; Extreme disables GUI)",
        "width": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "bundle": {
      "active": true,
      "targets": "all"
    }
  }
}