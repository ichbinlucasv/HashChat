cabal-version: 3.0
name: hashchat
version: 0.1.9
build-type: Simple

flag desktop
  description: Build the legacy GTK desktop frontend (heavy dependency)
  default: False
  manual: True

flag tui
  description: Build the modern Brick TUI (requires vty + vty-unix + brick)
  default: True
  manual: True

library
  exposed-modules: HashChat.Core HashChat.Profile HashChat.Queue HashChat.FileTransfer HashChat.Contact HashChat.Voice HashChat.Call HashChat.Settings HashChat.Security HashChat.Group HashChat.Chat HashChat.Tor HashChat.Relay
  build-depends: base, stm, cryptonite, memory, sqlite-simple, bytestring, time, text,
                  containers, directory, filepath, process, unix
  hs-source-dirs: src/haskell
  default-language: Haskell2010
-- Real production desktop target: Beautiful Brick TUI (black/yellow theme)
-- This replaced the old GTK attempt. Run with: cabal run hashchat-tui
executable hashchat-tui
  main-is: TUI.hs
  hs-source-dirs: app-desktop
  other-modules: MessageUI
  if !flag(tui)
    buildable: False
  build-depends: hashchat,
                  base, containers, directory, filepath, bytestring, text,
                  brick, vty, vty-unix, vector, time
  default-language: Haskell2010
  ghc-options: -threaded -rtsopts -with-rtsopts=-N -optl -Wl,-rpath,rust-lib
  -- Rust FFI library (required for ratchet + encrypted messaging)
  extra-lib-dirs: rust-lib
  extra-libraries: hashchat_rust

-- Legacy alias (points at CLI). Do not use for new development.
-- The real desktop experience is the Brick TUI (hashchat-tui target).
executable hashchat-desktop
  main-is: Main.hs
  hs-source-dirs: src/haskell
  build-depends: hashchat
  default-language: Haskell2010

executable hashchat-cli
  main-is: Main.hs
  hs-source-dirs: src/haskell
  build-depends:
    hashchat,
    base,
    bytestring,
    text,
    containers,
    directory,
    filepath,
    process,
    unix,
    stm,
    cryptonite,
    memory,
    sqlite-simple,
    time
  default-language: Haskell2010
  other-modules:
    HashChat.Call
    HashChat.Chat
    HashChat.Contact
    HashChat.Core
    HashChat.FileTransfer
    HashChat.Group
    HashChat.Profile
    HashChat.Queue
    HashChat.Relay
    HashChat.Security
    HashChat.Settings
    HashChat.Tor
    HashChat.Voice
  -- Rust FFI library (produced by cargo build)
  extra-lib-dirs: rust-lib
  extra-libraries: hashchat_rust
  ghc-options: -optl -Wl,-rpath,rust-lib

-- Phase3 High priority: self-hostable relay server binary (open protocol for community relays, paid hosting per freemium).
-- Run: cabal run hashchat-relay
-- Integrates Relay.hs (announce, queue sync for offline/mesh/Starlink failover).
executable hashchat-relay
  main-is: RelayMain.hs
  hs-source-dirs: app-relay
  build-depends: hashchat,
                  base, bytestring, containers, directory, filepath, process, unix, stm, text
  default-language: Haskell2010
  ghc-options: -threaded -rtsopts -with-rtsopts=-N