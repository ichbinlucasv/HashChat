#!/usr/bin/env bash
# Launch the Rust TUI (ratatui). Haskell Brick is no longer the default.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

echo "=== HashChat Rust TUI ==="
if [ -f /etc/os-release ]; then
  . /etc/os-release
  echo "Distro: ${NAME:-Unknown} ${VERSION_ID:-}"
fi
if ! pgrep -x tor >/dev/null 2>&1; then
  echo "[WARNING] Tor does not appear to be running (SOCKS 9050)."
fi

if [[ ! -x target/release/hashchat-tui ]]; then
  echo "[INFO] Building hashchat-tui (Rust)..."
  cargo build --release --locked --features tui --bin hashchat-tui
fi

exec target/release/hashchat-tui "$@"
