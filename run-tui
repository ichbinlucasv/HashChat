#!/usr/bin/env bash
# Simple launcher for the HashChat Brick TUI
# Automatically sets LD_LIBRARY_PATH so the Rust FFI library is found.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/rust-lib"

if [ ! -d "$LIB_DIR" ]; then
  echo "Error: rust-lib/ directory not found."
  echo "Run: cargo build --release && mkdir -p rust-lib && cp target/release/libhashchat_rust.so rust-lib/"
  exit 1
fi

if [ ! -f "$LIB_DIR/libhashchat_rust.so" ]; then
  echo "Warning: libhashchat_rust.so not found in rust-lib/. The TUI may fail to start."
fi

export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

echo "Starting HashChat TUI..."
echo "LD_LIBRARY_PATH includes: $LIB_DIR"

exec cabal run hashchat-tui -- "$@"
