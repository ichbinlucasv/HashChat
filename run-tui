#!/usr/bin/env bash
#
# HashChat desktop launcher — prefers the native Rust TUI.
#
# Order:
#   1) ./target/release/hashchat-tui  (cargo --features tui)
#   2) build it if cargo is available
#   3) transitional Haskell: cabal run hashchat-tui
#
# OPSEC: prints environment diagnostics only — never secrets, cookies, or keys.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

LIB_DIR="$SCRIPT_DIR/rust-lib"
RUST_LIB="$LIB_DIR/libhashchat_rust.so"
RUST_BIN_RELEASE="$SCRIPT_DIR/target/release/hashchat-tui"
RUST_BIN_DEBUG="$SCRIPT_DIR/target/debug/hashchat-tui"

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1090
  source "$HOME/.cargo/env"
fi

echo "=== HashChat Desktop TUI Launcher (Rust-first) ==="

# --- Desktop environment diagnostics ---
echo "=== Desktop Environment Check ==="
echo "OS: $(uname -s) | Kernel: $(uname -r)"
if [ -f /etc/os-release ]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  echo "Distro: ${NAME:-Unknown} ${VERSION_ID:-}"
fi

echo "Audio backends detected:"
if command -v pw-record >/dev/null 2>&1; then
  echo "  - PipeWire (pw-record) — recommended on modern Fedora/Ubuntu/Arch"
fi
if command -v parecord >/dev/null 2>&1; then
  echo "  - PulseAudio (parecord)"
fi
if command -v arecord >/dev/null 2>&1; then
  echo "  - ALSA (arecord) — common fallback on minimal Tails/Qubes"
fi
if ! command -v pw-record >/dev/null 2>&1 \
  && ! command -v parecord >/dev/null 2>&1 \
  && ! command -v arecord >/dev/null 2>&1; then
  echo "  - (none detected — voice may be unavailable)"
fi

if ! pgrep -x tor >/dev/null 2>&1; then
  echo "[WARNING] Tor does not appear to be running."
  echo "          Default path needs SOCKS (9050/9150) + ControlPort 9051 + CookieAuthentication."
  echo "          - Fedora/Ubuntu/Arch: install tor; torrc SocksPort 9050 + ControlPort 9051 + CookieAuthentication 1;"
  echo "            systemctl enable --now tor; ensure cookie (e.g. /run/tor/control.authcookie) is readable"
  echo "          - Tails: Tor usually preconfigured; ControlPort/:listen may be restricted"
  echo "          - Qubes: sys-whonix; SOCKS via Tor NetVM; ControlPort may be onion-grater filtered"
  echo "          See INSTALL.md — never cat/paste ControlPort cookies into chats/logs."
fi

ensure_rust_lib() {
  if [ -f "$RUST_LIB" ]; then
    return 0
  fi
  if [ -f "$SCRIPT_DIR/target/release/libhashchat_rust.so" ]; then
    mkdir -p "$LIB_DIR"
    cp -f "$SCRIPT_DIR/target/release/libhashchat_rust.so" "$LIB_DIR/"
    return 0
  fi
  return 1
}

build_rust_tui() {
  if ! command -v cargo >/dev/null 2>&1; then
    return 1
  fi
  echo "[INFO] Building Rust TUI: cargo build --release --bin hashchat-tui --features tui"
  cargo build --release --locked --bin hashchat-tui --features tui
  mkdir -p "$LIB_DIR"
  if [ -f "$SCRIPT_DIR/target/release/libhashchat_rust.so" ]; then
    cp -f "$SCRIPT_DIR/target/release/libhashchat_rust.so" "$LIB_DIR/"
  fi
  return 0
}

# Prefer release Rust binary; accept debug if already built
if [ -x "$RUST_BIN_RELEASE" ]; then
  echo "[INFO] Using Rust binary: $RUST_BIN_RELEASE"
  ensure_rust_lib || true
  export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  echo "Starting HashChat Rust TUI (Tor-first, black + gold)..."
  exec "$RUST_BIN_RELEASE" "$@"
fi

if [ -x "$RUST_BIN_DEBUG" ]; then
  echo "[INFO] Using Rust debug binary: $RUST_BIN_DEBUG"
  ensure_rust_lib || true
  export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  echo "Starting HashChat Rust TUI (debug build)..."
  exec "$RUST_BIN_DEBUG" "$@"
fi

if build_rust_tui && [ -x "$RUST_BIN_RELEASE" ]; then
  echo "[INFO] Using freshly built Rust binary: $RUST_BIN_RELEASE"
  export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  echo "Starting HashChat Rust TUI (Tor-first, black + gold)..."
  exec "$RUST_BIN_RELEASE" "$@"
fi

echo "[WARN] Rust TUI unavailable — trying transitional Haskell path (cabal)."
ensure_rust_lib || {
  if command -v cargo >/dev/null 2>&1; then
    echo "[INFO] Building Rust FFI library for Haskell fallback..."
    cargo build --release --locked || true
    mkdir -p "$LIB_DIR"
    cp -f "$SCRIPT_DIR/target/release/libhashchat_rust.so" "$LIB_DIR/" 2>/dev/null || true
  fi
}

export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if command -v cabal >/dev/null 2>&1; then
  echo "Starting HashChat Haskell TUI (transitional)..."
  exec cabal run hashchat-tui -- "$@"
fi

echo "[ERROR] Neither Rust hashchat-tui nor cabal is available."
echo "        Install Rust (rustup), then:"
echo "          cargo build --release --bin hashchat-tui --features tui"
echo "        Or use Nix/Flatpak: nix build .#hashchat-flatpak"
echo "        See INSTALL.md (branch codeberg-primary)."
exit 1
