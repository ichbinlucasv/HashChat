#!/usr/bin/env bash
# Convenient launcher for the HashChat Brick TUI
# Sets LD_LIBRARY_PATH correctly and prefers a release build if available.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/rust-lib"

if [ ! -d "$LIB_DIR" ] || [ ! -f "$LIB_DIR/libhashchat_rust.so" ]; then
  echo "Rust library not found in rust-lib/. Building..."
  cargo build --release
  mkdir -p "$LIB_DIR"
  cp target/release/libhashchat_rust.so "$LIB_DIR/" 2>/dev/null || true
fi

export LD_LIBRARY_PATH="$LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

echo "Starting HashChat TUI (real Double Ratchet + encrypted persistence)..."
echo "LD_LIBRARY_PATH: $LIB_DIR"

exec cabal run hashchat-tui -- "$@"
