{
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.checkOnSave.command": "clippy",
    "editor.formatOnSave": true,
    "files.exclude": {
        "**/target": true,
        "**/dist-newstyle": true,
        "**/rust-lib": true
    },
    "search.exclude": {
        "**/target": true,
        "**/dist-newstyle": true
    }
}