<?xml version="1.0" encoding="utf-8"?>
<!-- HashChat Android — black + gold (#FFD700) theme to exactly match desktop Brick TUI.
     SimplexChat visual + functional parity goal: RecyclerView messages with bubbles,
     bottom input bar, contact long-press showing Block / Report / Delete / Disappear / Security info,
     burner/decoy profiles, dynamic posture, Tor-only, panic wipe.
     This layout + MainActivity + future Adapter gives the "very close look and style".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Top bar: profile + security posture (matches TUI title) -->
    <TextView android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:textColor="#FFD700"
        android:text="HashChat — Profile: Default  |  Security: MAX PARANOID  |  Tor v3"
        android:padding="8dp"
        android:textStyle="bold"/>

    <!-- Message list - REAL RecyclerView (replace the old button list) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="8dp" />

    <!-- Bottom input bar (exact Simplex/TUI parity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:padding="4dp">
        <EditText android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Message (encrypted with Double Ratchet)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFD700"
            android:inputType="textShortMessage"/>
        <Button android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:textColor="#000000"
            android:background="#FFD700"/>
    </LinearLayout>

    <!-- Quick Simplex-style action buttons (will be replaced by long-press on list items) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#111">
        <Button android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Block" android:textColor="#FFD700" android:background="#1A1A1A" android:onClick="onBlockContact"/>
        <Button android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Report" android:textColor="#FFD700" android:background="#1A1A1A" android:onClick="onReportContact"/>
        <Button android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Delete" android:textColor="#FF4444" android:background="#1A1A1A" android:onClick="onDeleteChat"/>
        <Button android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Wipe" android:textColor="#FF4444" android:background="#1A1A1A" android:onClick="onPanicWipe"/>
    </LinearLayout>
</LinearLayout>